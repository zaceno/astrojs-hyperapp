{
  "name": "astrojs-hyperapp",
  "version": "4.0.0",
  "description": "Hyperapp islands for Astro",
  "type": "module",
  "keywords": [
    "astro",
    "hyperapp",
    "withastro",
    "renderer",
    "islands"
  ],
  "engines": {
    "node": ">=22.20.0"
  },
  "files": [
    "dist/",
    "src/",
    "README.md",
    "LICENSE.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./synced-islands": {
      "types": "./dist/synced-islands.d.ts",
      "default": "./dist/synced-islands.js"
    },
    "./synced-islands.js": {
      "types": "./dist/synced-islands.d.ts",
      "default": "./dist/synced-islands.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "magic-string": "^1.4.3",
    "vite-plugin-hyperapp": "^2.0.3"
  },
  "peerDependencies": {
    "astro": "^7.3.8",
    "hyperapp": "^2.0.22",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zaceno/astrojs-hyperapp.git"
  },
  "author": "Zacharias Enochsson",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/zaceno/astrojs-hyperapp/issues"
  },
  "homepage": "https://github.com/zaceno/astrojs-hyperapp#readme"
}
